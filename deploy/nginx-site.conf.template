# Substitute DOMAIN and certificate paths after issuing a certificate.
server {
    listen 80;
    server_name DOMAIN;
    access_log off;
    error_log /dev/null;
    location ^~ /.well-known/acme-challenge/ { root /var/www/remember-me-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name DOMAIN;
    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    # Error messages can include request URIs, including path keys/Tickets.
    error_log /dev/null;
    client_max_body_size 11m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /mcp { return 404; }
    location ^~ /mcp/ { return 404; }
    include /etc/remember-me/nginx-mcp.conf;
    location / { return 404; }
    location = / { return 302 /dashboard; }
    location ~ ^/(?:api/v1(?:/|$)|transfers/(?:uploads|downloads)/|dashboard(?:/|$)|healthz$|readyz$) {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host DOMAIN;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Host "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
}
